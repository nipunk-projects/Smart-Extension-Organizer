{
  "manifest_version": 3,
  "name": "Smart Extension Organizer",
  "version": "1.0.0",
  "description": "Ultra-compact, high-performance extension manager with permanent categories, cross-category sets, snapshot revert, and site auto-rules.",
  "permissions": [
    "management",
    "storage",
    "tabs",
    "unlimitedStorage",
    "sidePanel"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Smart Extension Organizer"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  }
}
